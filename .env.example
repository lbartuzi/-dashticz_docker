# Dashticz Docker Environment Configuration
# Copy this file to .env and customize for your setup

# Domoticz Configuration
DOMOTICZ_IP=192.168.1.100:8080
DOMOTICZ_USERNAME=
DOMOTICZ_PASSWORD=

# Dashticz Settings
# Branch: master (stable) or beta (latest features)
DASHTICZ_BRANCH=master
# Port to expose Dashticz (change if 8082 is already in use)
DASHTICZ_PORT=8082

# Timezone Configuration
TIMEZONE=Europe/Amsterdam

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_POST_MAX_SIZE=50M
PHP_UPLOAD_MAX_FILESIZE=50M
PHP_MAX_EXECUTION_TIME=300

# Container Configuration
CONTAINER_NAME=dashticz
# Restart policy: always, unless-stopped, on-failure, no
RESTART_POLICY=unless-stopped

# Resource Limits (optional)
# CPU limit (1.0 = 1 CPU core)
CPU_LIMIT=1.0
# Memory limit
MEMORY_LIMIT=512M

# User/Group IDs (for file permissions)
# Find your IDs with: id -u and id -g
PUID=1000
PGID=1000

# Logging
LOG_LEVEL=info
# Options: json-file, syslog, journald, none
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Development Mode
# Set to true to enable debug mode
DEBUG_MODE=false
